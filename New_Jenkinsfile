pipeline {
   agent any
    tools {
  maven 'M2_HOME'
  }
     environment {
        NEXUS_VERSION = "nexus3"
        NEXUS_PROTOCOL = "http"
        NEXUS_URL = "http://ec2-54-88-43-55.compute-1.amazonaws.com:8080/job/geolocalization/"
        NEXUS_REPOSITORY = "geo"
        NEXUS_CREDENTIAL_ID = "nexus-userID"
    }
    stages {
        // Stage 1: Clean
        stage('Clean') {
            steps {
                echo 'Cleaning the project...'
                sh 'mvn clean'
            }
        }

        // Stage 2: Install
        stage('Install') {
            steps {
                echo 'Installing dependencies...'
                sh 'mvn install'
            }
        }

        // Stage 3: Compile
        stage('Compile') {
            steps {
                echo 'Compiling the project...'
                sh 'mvn compile'
            }
        }

        // Stage 4: Test
        stage('Test') {
            steps {
                echo 'Running tests...'
                sh 'mvn test'
            }
        }

        // Stage 5: Package
        stage('Package') {
            steps {
                echo 'Packaging the project...'
                sh 'mvn package'
            }
        }
    }

    post {
        // If the pipeline succeeds
        success {
            echo 'Pipeline completed successfully!'
        }

        // If the pipeline fails
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
